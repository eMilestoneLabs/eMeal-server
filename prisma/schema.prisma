// prisma/schema.prisma
// Smart Meal & Attendance Management SaaS — eMeal Backend
// Contract: Frontend-locked. Do NOT rename fields without full DTO audit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS — values match Flutter enum serialization exactly
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  student
  member
  guest
  messManager
  hostelManager
  hostelAdmin
  organizationManager
  eventAdmin
  eventGuest
}

// CRITICAL: 10 exact values — verified from lib/shared/models/group_model.dart
// DO NOT add "organization" or "eventSystem" — they do not exist in Flutter
enum GroupType {
  hostel
  mess
  cafeteria
  pg
  coachingInstitute
  office
  factory       // Note: Dart uses factory_ (reserved word) → JSON = "factory"
  community
  event         // Note: Flutter uses "event", old plan wrongly had "eventSystem"
  other
}

enum AttendanceStatus {
  pending
  present
  absent
  skipped
  onVacation
}

// NO MealType enum — meal slots are free-form slotKey VARCHAR
// This is intentional: dynamic rendering architecture

// NO EventType enum — event types are free-form String
// Polish.txt: "DO NOT create EventType enum. Event type MUST remain dynamic string."
// Examples: "wedding", "corporate", "birthday", "festival", or any custom value

enum AuditAction {
  create
  update
  delete
  login
  logout
  join
  leave
  block
  unblock
  export
}

// Phase B2 — Group membership role + status
enum MemberRole {
  member
  moderator
  groupManager
}

enum MemberStatus {
  active
  pending
  blocked
  removed
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION — Multi-tenant root. Every other entity belongs to one.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  planTier  String   @default("free")
  timezone  String   @default("Asia/Kolkata") // IANA timezone, MVP default IST
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  groups            Group[]
  meals             Meal[]
  mealSchedules     MealSchedule[]
  attendanceRecords AttendanceRecord[]
  events            Event[]
  auditLogs         AuditLog[]

  @@index([slug])
  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER — All operational fields required by Flutter UserModel.fromJson
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  organizationId String?  // null for event-only guests before org assignment

  // Identity
  name           String
  email          String?
  phone          String?
  passwordHash   String?
  role           UserRole @default(student)
  gender         String?
  age            Int?
  avatarUrl      String?

  // Operational fields — required by Flutter UserModel (M-08, M-09 fixes)
  isVacationMode      Boolean @default(false)
  isDefaultAttendance Boolean @default(false)
  remindersEnabled    Boolean @default(true)
  loginPreference     String? @default("email") // "email" | "mobile"
  fcmToken            String? // Phase B6: Firebase FCM push token
  emailVerifiedAt     DateTime? // SRS AUTH-036/040: set when Email OTP verification succeeds (null = unverified)

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  // Pass 14 (FR-DEL-011/FR-DLC-003): set when the account was deleted and its
  // PII anonymized in place — the row itself is retained for financial/audit FKs.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  groupMembers      GroupMember[]
  refreshTokens     RefreshToken[]
  otpRequests       OtpRequest[]
  attendanceRecords AttendanceRecord[]
  actedAuditLogs    AuditLog[]         @relation("ActorAuditLogs")

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// REFRESH TOKEN — Family-based rotation. Reuse = theft detection.
// ─────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique  // SHA-256 hash of the token (deterministic for DB lookup)
  family    String            // rotation family UUID — reuse in same family = theft
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  // Rotation lineage (mobile lost-response rescue): a revoked token whose
  // successor was NEVER used means the client never received the rotation
  // response — rescued in-family instead of tripping theft detection.
  usedAt       DateTime?
  replacedById String?   // id of the successor token issued at rotation

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// OTP REQUEST — For Firebase Auth OTP flow (Phase B1 placeholder, full Phase B7)
// ─────────────────────────────────────────────────────────────────────────────

model OtpRequest {
  id         String   @id @default(cuid())
  userId     String?
  identifier String            // email or phone
  otpHash    String            // bcrypt-hashed OTP code
  purpose    String            // "login" | "signup" | "reset"
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier])
  @@index([expiresAt])
  @@map("otp_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// GROUP — Represents hostel/mess/cafeteria/org/factory/etc.
// mealConfig stored as embedded JSONB columns for direct Flutter contract mapping
// ─────────────────────────────────────────────────────────────────────────────

model Group {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  type           GroupType @default(hostel)
  description    String?
  adminId        String?   // The admin user who created/owns the group

  // QR join — DB stores as joinToken, API serializes as "joinCode" (M-06 fix)
  joinToken          String    @unique @default(cuid())
  joinTokenExpiresAt DateTime?

  // GroupMealConfig — exact field names as expected by Flutter GroupMealConfig.fromJson
  // (M-07 fix: NOT mealPrefsEnabled, NOT missing vacationModeEnabled)
  mealsEnabled         Boolean  @default(true)
  weeklyMenuEnabled    Boolean  @default(false)
  dayWiseMealsEnabled  Boolean  @default(false)   // additive: mutually exclusive with weeklyMenuEnabled (Day-Wise Meal Mode)
  preferencesEnabled   Boolean  @default(false)   // serialized as "preferencesEnabled"
  enabledPreferences   String[] @default([])       // lowercase: "veg","chicken","fish","mutton","egg","jain"
  vacationModeEnabled  Boolean  @default(true)
  // SRS FR-VACX-001 (Pass 11): when ON, the instant self-service vacation
  // toggle is disabled for members of this group — a dated VacationRequest
  // with admin approval is required instead.
  vacationRequiresApproval Boolean @default(false)
  // SRS FR-BILLX-020 (Pass 12): day-of-month (1–28) the billing cycle starts.
  // Null = calendar month. All period math uses the org timezone.
  // BILL-012: 1–31; effective anchor clamps to a short month's last day.
  billingCycleStartDay Int?
  // SRS Module 03 RET-012/013/015: next rolling retention review instant.
  // Null = not yet initialized (first sweep sets createdAt + 3 months).
  // LEGACY — superseded by retentionPurgeThrough (billing-cycle-aligned
  // retention). Kept so historical rows/queries are never invalidated.
  retentionReviewAt DateTime?

  // ── Billing-cycle-aligned retention (3 COMPLETE cycles) ────────────────────
  // FROZEN purge boundary: the last day of the 3rd complete billing cycle of
  // the current retention window (UTC midnight, inclusive). Everything on or
  // before it is eligible; the ACTIVE cycle is always excluded.
  //
  // It is stored (not derived from `now`) precisely so it CANNOT drift when a
  // sweep runs late, retries, or crosses into the next cycle. After a
  // successful purge it advances by exactly 3 cycles.
  retentionPurgeThrough DateTime?

  // One-time billing-cycle-start-day change (per group). Null = the admin may
  // still change it once; set = the privilege is permanently consumed.
  // Server-side truth — reinstalling the app or clearing cache cannot restore it.
  billingCycleChangedAt DateTime?
  // Additive: when ON, meals carry a ₹ price; shown to students + used for billing/exports
  mealPricingEnabled   Boolean  @default(false)
  // SRS FR-TIME-005 (LOOP-090): per-group grace period (minutes) that extends
  // the attendance-window close for late marking. Null = 0 (no grace).
  attendanceGraceMinutes Int?
  // SRS FR-TRUST-001 (Module 33): group trust model. 'absent' (opt-in, the
  // legacy behavior — not marking means not counted/billed) or 'present'
  // (opt-out — unmarked members are auto-marked Present at window close by the
  // system-default sweep, source='system_default'). Null = 'absent'.
  attendanceDefault String?
  // SRS FR-TRUST-003: fair-opportunity floor for opt-out — the window must
  // have been open at least this many minutes for auto-billing to be valid.
  // Null = server default (ATTENDANCE_MIN_OPT_OUT_MINUTES, 30).
  minOptOutMinutes Int?

  // ── Module 22 (Pass 8) — Member-Hosted Guests config (FR-HG-020) ──────────
  // All additive. Nulls = server defaults resolved in code, so existing
  // groups are untouched (feature default OFF).
  guestAttendanceEnabled        Boolean @default(false)
  maxGuestsPerMemberPerMeal     Int?    // null = default (5)
  maxGuestsPerMemberPerDay      Int?    // null = no per-day cap
  guestPricingMode              String? // sameAsMember | flatSurcharge | perGuestPrice
  guestAdultPrice               Int?    // perGuestPrice mode
  guestChildPrice               Int?    // perGuestPrice mode
  guestSurcharge                Int?    // flatSurcharge mode (added to meal price; ₹ when fixed, % when percent)
  // SRS Module 03 GST-011: surcharge calculation method for flatSurcharge mode.
  // 'fixed' (default, ₹ amount) | 'percent' (% of final effective member price).
  guestSurchargeType            String? // fixed | percent (null = fixed)
  guestRequiresApproval         Boolean @default(false)
  guestCutoffMinutesBeforeClose Int?    // null = 0 (bookable until close)
  guestAdvanceBookingDays       Int?    // null = 0 (same-day only)
  guestPreferenceRequired       Boolean @default(false)
  allowGuestWithoutHost         Boolean @default(false)
  billNoShowGuests              Boolean @default(true) // LOOP-013 policy
  // SRS Module 03 (survey Q17/Q22): "Bill Skip" policy — when ON, member-chosen
  // Absent AND system-generated Skip are billed at the final scheduled price
  // (base + day override, no add-ons). Default OFF = today's live behaviour.
  billSkippedMeals              Boolean @default(false)
  // Live-Test-7 ISSUE-4: independent "Bill Absent Meals" policy. NULL =
  // legacy coupling (Absent follows billSkippedMeals, exactly the pre-split
  // behaviour, so existing groups' bills never move); an explicit true/false
  // decouples Absent billing from Skip billing.
  billAbsentMeals               Boolean?

  maxMembers Int?

  // ── Module 02 (MODULE_02 SRS) — Organization & Group Management ────────────
  // All additive + nullable so existing rows are untouched. GRP-003 lists these
  // as captured at creation and immutable in the current release (ORG-008 /
  // GRP-009) — the service ignores them on update. Kept configurable-ready for
  // a future release without a schema change.
  country  String? // GRP-003 (captured at create, immutable)
  state    String? // GRP-003
  city     String? // GRP-003
  pin      String? // GRP-003 (command_3 Issue 8) — postal/PIN code, captured at create
  address  String? // GRP-003
  timezone String? // GRP-003 — group display timezone (null = inherit org tz)
  currency String? // GRP-003 — ISO 4217 code (null = inherit org / default)

  // GRP-003 / MEM-004: Join Approval Mode. When true, a join creates a PENDING
  // GroupMember that an admin must approve before it becomes active.
  joinApprovalRequired Boolean @default(false)

  // GRP-013 / CFG-014: QR/Join-Code expiry policy captured at creation, in
  // days. Null = Never expires. The concrete deadline lives in
  // joinTokenExpiresAt; this remembers the policy for regeneration.
  qrExpiryDays Int?

  isActive   Boolean  @default(true)
  // GRP-016/019: soft-archive marker for restore/permanent-delete workflow.
  // isActive=false = archived; archivedAt records when. Null while active.
  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members           GroupMember[]
  meals             Meal[]
  attendanceRecords AttendanceRecord[]
  mealSchedules     MealSchedule[]

  @@index([organizationId])
  @@index([joinToken])
  @@map("groups")
}

// ─────────────────────────────────────────────────────────────────────────────
// GROUP MEMBER — Join table with block/unblock support
// ─────────────────────────────────────────────────────────────────────────────

model GroupMember {
  id        String       @id @default(cuid())
  groupId   String
  userId    String
  role      MemberRole   @default(member)
  // Additive (#8): per-group functional title chosen by admin
  // (e.g. messManager in one group, hostelAdmin in another).
  // NULL -> client falls back to the user's global User.role.
  functionalRole UserRole?
  status    MemberStatus @default(active)
  joinedAt  DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Audit trail — who performed the status change and when
  blockedAt DateTime?
  blockedBy String?   // userId of admin who blocked
  removedAt DateTime?
  removedBy String?   // userId of admin who removed

  // ── Module 02 (MEM-004/006/007) — Join Approval workflow ───────────────────
  // Set when an admin approves/rejects a PENDING join request. Additive +
  // nullable so existing rows and the immediate-join path are unaffected.
  reviewedBy String?   // admin userId who approved/rejected the pending request
  reviewedAt DateTime? // when the decision was taken
  reviewNote String?   // optional rejection reason (MEM-007)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([status])
  @@map("group_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// MEAL — NO MealType enum. slotKey is free-form VARCHAR (dynamic rendering)
// attendanceWindowOpen/Close stored flat, serialized as nested attendanceWindow
// ─────────────────────────────────────────────────────────────────────────────

model Meal {
  id             String  @id @default(cuid())
  organizationId String
  groupId        String

  // slotKey is free-form: "breakfast","lunch","dinner","iftar","sehri","high-tea","midnightMeal"
  // NEVER enum — dynamic rendering architecture requires free-form strings
  slotKey  String
  name     String  // internal admin-facing name (used as fallback for displayName)
  displayName String? // student-facing label; null = fall back to name in serializer

  order Int @default(0) // display ordering controlled by admin

  description String?
  menuItems   String[] @default([]) // TEXT[] of menu item names
  imageUrl    String?               // singular imageUrl (not imageUrls[])

  // Visibility flags — two separate flags (B3 contract requirement)
  isActive          Boolean @default(true)  // serialized as "isActive" in API response — Flutter reads isActive (NOT isEnabled)
  // ISSUE-001 (Live-Test-13): DELETE and DISABLE are different business
  // operations and must stay distinguishable. Both used to set isActive=false
  // only, so the Master Meal Template could not show disabled meals (for
  // re-enabling) without also resurrecting deleted ones.
  //   deletedAt = null  → DISABLE (temporary; stays in the template, re-enableable)
  //   deletedAt != null → DELETE  (permanent; never listed, never re-enableable)
  // The ROW is never removed: attendance, billing, reports and previously
  // published schedules keep referencing it, so history stays intact.
  deletedAt         DateTime?
  attendanceEnabled Boolean @default(true)  // attendance can remain when meal is hidden

  // Preference system — two-level (group-level + per-meal override)
  preferencesEnabled Boolean  @default(false)
  enabledPreferences String[] @default([]) // empty = inherit from group mealConfig
  // Additive: master ₹ meal price (null when pricing disabled/unset). Per-day override lives on ScheduleEntry.price
  price              Int?

  // Attendance window — stored flat, serialized as nested { openTime, closeTime }
  // (M-04 fix: attendanceWindow MUST always be nested in API response)
  attendanceWindowOpen  String? // "HH:mm" local time in org timezone
  attendanceWindowClose String? // "HH:mm" local time in org timezone

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group             Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scheduleEntries   ScheduleEntry[]
  attendanceRecords AttendanceRecord[]
  // Module 36 (FR-PG-012): explicit multi-dimensional preference groups.
  // Empty = legacy flat enabledPreferences[] behaviour (FR-PG-021).
  preferenceGroupBindings MealPreferenceGroup[]

  @@index([organizationId])
  @@index([groupId])
  @@index([isActive])
  @@index([order])
  // ISSUE-001: every template listing filters on it, so it rides an index.
  @@index([deletedAt])
  @@map("meals")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 36 — MULTI-DIMENSIONAL PREFERENCE GROUPS (FR-PG-*)
// A meal supports N choice dimensions ("Staple", "Non-Veg"), each with its own
// pick rule and priced options. Legacy Meal.enabledPreferences[] remains valid
// as one implicit group (FR-PG-021) — fully additive, zero data loss.
// ─────────────────────────────────────────────────────────────────────────────

model PreferenceGroup {
  id             String  @id @default(cuid())
  organizationId String  // tenant isolation (from JWT, never client)
  groupId        String? // null = org-level template; set = group-scoped (FR-PG-073)
  scope          String  @default("group") // org | group | meal (where it lives/reused)
  label          String  // student-facing dimension name, e.g. "Staple"
  description    String?
  order          Int     @default(0)
  selectionType  String  @default("single") // single | multiple
  minSelect      Int     @default(1)
  maxSelect      Int     @default(1)
  required       Boolean @default(true)
  quantityEnabled Boolean @default(false)
  // FR-PG-060 conditional visibility: {"groupId": "...", "optionKey": "..."}
  visibleWhen    Json?
  vegOnly        Boolean @default(false) // FR-PG-061
  isActive       Boolean @default(true)  // soft disable — history preserved (FR-PG-072)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options      PreferenceOption[]
  mealBindings MealPreferenceGroup[]

  @@index([organizationId])
  @@index([groupId, isActive])
  @@map("preference_groups")
}

model PreferenceOption {
  id                String  @id @default(cuid())
  preferenceGroupId String
  key               String  // canonical lowercase, immutable once selections exist
  label             String  // student-facing, e.g. "Ruti"
  emoji             String?
  color             String? // hex
  isVeg             Boolean @default(true)
  priceDelta        Int     @default(0) // ₹ minor units added to base (FR-PG-040)
  minQty            Int     @default(1) // used only when group.quantityEnabled
  maxQty            Int     @default(1)
  order             Int     @default(0)
  isActive          Boolean @default(true) // soft disable (FR-PG-072)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group PreferenceGroup @relation(fields: [preferenceGroupId], references: [id], onDelete: Cascade)

  @@unique([preferenceGroupId, key])
  @@index([preferenceGroupId, isActive])
  @@map("preference_options")
}

model MealPreferenceGroup {
  id                String   @id @default(cuid())
  mealId            String
  preferenceGroupId String
  order             Int      @default(0)
  // Live-Test-8 ISSUE-001/002: false = binding SUSPENDED (meal switched to
  // Standalone mode) — the group stays attached for restore but drops out of
  // every effective view. Default true keeps all existing rows live.
  isActive          Boolean  @default(true)
  // Per-meal rule overrides — null = use the group's own rule (FR-PG-012)
  requiredOverride  Boolean?
  minSelectOverride Int?
  maxSelectOverride Int?

  createdAt DateTime @default(now())

  meal            Meal            @relation(fields: [mealId], references: [id], onDelete: Cascade)
  preferenceGroup PreferenceGroup @relation(fields: [preferenceGroupId], references: [id], onDelete: Cascade)

  @@unique([mealId, preferenceGroupId])
  @@index([mealId])
  @@map("meal_preference_groups")
}

// One row per chosen option — snapshotted for historical integrity (FR-PG-013/072).
// The JSON mirror lives on AttendanceRecord.preferences.
model AttendancePreferenceSelection {
  id                  String  @id @default(cuid())
  attendanceRecordId  String
  preferenceGroupId   String  // soft FK — group may later be edited/disabled
  groupLabelSnapshot  String
  optionKey           String
  optionLabelSnapshot String
  isVegSnapshot       Boolean @default(true)
  priceDeltaSnapshot  Int     @default(0) // immutable — later edits never change past bills
  quantity            Int     @default(1)

  createdAt DateTime @default(now())

  record AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([attendanceRecordId])
  @@index([preferenceGroupId, optionKey]) // cross-tab analytics (FR-PG-050)
  @@map("attendance_preference_selections")
}

// ─────────────────────────────────────────────────────────────────────────────
// MEAL SCHEDULE — Weekly schedule (isPublished controls student visibility)
// organizationId stored directly for efficient org-scoped queries (no join needed)
// ─────────────────────────────────────────────────────────────────────────────

model MealSchedule {
  id             String   @id @default(cuid())
  organizationId String   // direct org column for isolation — avoids extra join
  groupId        String
  weekStart      DateTime // Monday of the week (UTC midnight). Serialized as YYYY-MM-DD date string.
  isPublished    Boolean  @default(false)
  // Issue 1 — frozen copy of the entries as of the last publish. Students ALWAYS
  // read this snapshot (gated on publishedAt != null), so editing/reverting to a
  // draft never changes what students see until the next publish. Admin reads the
  // live `entries` (the draft). Additive, nullable.
  publishedSnapshot Json?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entries      ScheduleEntry[]

  @@unique([groupId, weekStart])
  @@index([organizationId])
  @@index([groupId])
  @@index([weekStart])
  @@map("meal_schedules")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCHEDULE ENTRY — Per-day meal assignment with optional timing overrides
// day/slotKey in API response derived from dayOfWeek Int + joined Meal.slotKey
// ─────────────────────────────────────────────────────────────────────────────

model ScheduleEntry {
  id         String   @id @default(cuid())
  scheduleId String
  mealId     String
  dayOfWeek  Int      // 0=Monday ... 6=Sunday (serialized to "monday"..."sunday")
  date       DateTime // specific date (UTC midnight)
  openTime   String?  // per-day override (null = use meal template attendanceWindowOpen)
  closeTime  String?  // per-day override (null = use meal template attendanceWindowClose)
  mealName   String?  // what's being served on this day (e.g. "Poha", "Dal Rice")
  notes      String?  // optional notes shown to students (e.g. "Extra fruits today")
  // Additive: per-day meal description override (null = inherit master meal description).
  description String?
  // Additive: per-day meal image override (base64 data URI or URL; null = inherit
  // master meal image). One image per entry — replaced on re-upload, cleared on delete.
  imageUrl   String?
  // Additive (#6): per-day meal preference override. null = inherit from meal.
  preferencesEnabled Boolean?
  enabledPreferences String[] @default([])
  // Additive (#3): per-day SUBSET of the meal's master preference groups that
  // apply this day (group IDs). Empty = inherit ALL master groups (no change).
  enabledPreferenceGroupIds String[] @default([])
  menuItems          String[] @default([]) // per-day menu (independent of master meal)
  // Additive: per-day ₹ price override (null = inherit master Meal.price)
  price              Int?

  schedule MealSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  meal     Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, mealId, date])
  @@index([scheduleId])
  @@index([date])
  @@map("schedule_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE RECORD — Idempotent via unique(userId, mealId, attendanceDate)
// CRITICAL: @@unique([userId, mealId, attendanceDate]) is NON-NEGOTIABLE
// status default = present (students only mark when changing from default)
// markedBy replaces markedByAdmin + adminId (cleaner nullable userId)
// ─────────────────────────────────────────────────────────────────────────────

model AttendanceRecord {
  id             String           @id @default(cuid())
  organizationId String
  groupId        String
  userId         String
  mealId         String

  attendanceDate DateTime         // UTC midnight of the meal date (renamed from "date")
  status         AttendanceStatus @default(present) // default=present (was pending — B4 fix)

  preference String?   // "veg"|"chicken"|"fish"|"mutton"|"egg"|"jain" (exact lowercase)
  // Module 36 (FR-PG-013): immutable full multi-group selection snapshot
  // [{groupId,groupLabel,optionKey,optionLabel,isVeg,priceDelta,quantity}].
  // `preference` above stays populated as the derived primary (FR-PG-100).
  preferences Json?
  note       String?   // optional note from student or admin

  markedAt DateTime?
  markedBy String?    // userId of admin who performed manual override (nullable)
  // Additive: ₹ price snapshot at mark time (per-day override or master). Null = pre-pricing record.
  price    Int?
  // Live-Test-11 ISSUE-017 (survey-locked): Bill-Absent policy SNAPSHOT taken
  // when the record is written as `absent`. TRUE = the group's independent
  // Bill Absent Meals toggle was ON, so this absent bills at its price
  // snapshot. Null/false (incl. every pre-fix record) = absent stays free.
  // Date-forward by construction: later toggle flips never rewrite this.
  billAbsent Boolean?

  // Module 33 (MIG-010) consent trail — how this record came to exist:
  // self | default | system_default | admin | request | verified
  source          String? @default("self")
  // AttendanceCorrectionRequest id that produced this record (consent proof)
  sourceRequestId String?

  // Module 22 (Pass 8, FR-HG-012): denormalised hosted-guest counters —
  // updated in the SAME transaction as MealGuest changes for join-free reads.
  guestAdults   Int @default(0)
  guestChildren Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal         Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  // Module 36 (FR-PG-013): per-option child rows for cross-tab analytics
  preferenceSelections AttendancePreferenceSelection[]

  @@unique([userId, mealId, attendanceDate])    // idempotency — upsert key (NON-NEGOTIABLE)
  @@index([organizationId])
  @@index([groupId])
  @@index([mealId])
  @@index([attendanceDate])
  @@index([status])
  @@index([groupId, attendanceDate])
  @@index([userId, attendanceDate])
  @@map("attendance_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENT — Simplified event-focused system
// type is FREE-FORM String — Polish.txt: DO NOT create EventType enum
// groupId is optional — event may be tied to an existing group
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id             String   @id @default(cuid())
  organizationId String
  groupId        String?  // B5 Step 4: optional link to existing group
  adminId        String   // user who created the event
  name           String
  type           String   @default("other") // Polish.txt: free-form string, NOT EventType enum
  eventDate      DateTime
  expectedGuestCount Int  @default(0)

  // QR join — serialized as "joinCode" in API (same as groups pattern)
  joinToken            String   @unique @default(cuid())
  autoDeleteAfter7Days Boolean  @default(false)
  autoDeleteAt         DateTime? // eventDate + 7 days if autoDeleteAfter7Days=true

  // GAP-EVT-1 (RESOLVED): persisted event lifecycle (Event_admin.md §4 + §18)
  // Derived status: archivedAt → archived | date passed → expired |
  // closedAt → closed | otherwise upcoming. Serialized as additive "status".
  closedAt   DateTime? // admin "Close Event" danger-zone action
  archivedAt DateTime? // admin "Archive Event" (hidden, restorable)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mealTypes    EventMealType[]
  guestParties EventGuestParty[]

  @@index([organizationId])
  @@index([groupId])
  @@index([joinToken])
  @@index([autoDeleteAt])
  @@map("events")
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENT MEAL TYPE — M-14 fix: "title" not "name", emoji, colorValue INTEGER
// ─────────────────────────────────────────────────────────────────────────────

model EventMealType {
  id         String   @id @default(cuid())
  eventId    String
  title      String   // M-14 fix: "title" NOT "name"
  emoji      String?  // M-14 fix: emoji string
  colorValue Int?     // M-14 fix: ARGB32 integer (Flutter Color.toARGB32())
  isVeg      Boolean  @default(true)
  createdAt  DateTime @default(now())

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  persons EventPerson[]

  @@index([eventId])
  @@map("event_meal_types")
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENT GUEST PARTY — M-16 fix: primaryName, adultsCount, childrenCount, joinedAt
// organizationId for org-scoped queries (B5 Step 6 requirement)
// ─────────────────────────────────────────────────────────────────────────────

model EventGuestParty {
  id             String   @id @default(cuid())
  organizationId String   // B5 Step 6: required for org-isolation queries
  eventId        String
  primaryName    String   // M-16 fix: persons[0].displayName
  adultsCount    Int      @default(1)  // M-16 fix: "adultsCount" NOT "adultCount"
  childrenCount  Int      @default(0)  // M-16 fix: "childrenCount" NOT "childCount"
  joinedAt       DateTime @default(now()) // M-16 fix: was missing
  // Pass 14 (FR-EVTX-002): stable client key for party resume on app re-open.
  // Uniqueness per event enforced by a partial index in the migration.
  deviceKey      String?

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  persons EventPerson[]

  @@index([organizationId])
  @@index([eventId])
  @@index([eventId, deviceKey])
  @@map("event_guest_parties")
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENT PERSON — M-17 fix: "displayName" not "name", isPresent, selectedMealTypeId
// ─────────────────────────────────────────────────────────────────────────────

model EventPerson {
  id         String  @id @default(cuid())
  partyId    String
  mealTypeId String?

  displayName  String  // M-17 fix: "displayName" NOT "name"
  isAdult      Boolean @default(true)
  isPrimary    Boolean @default(false)
  isNameEdited Boolean @default(false)
  isPresent    Boolean @default(false) // M-17 fix: was missing

  selectedMealTypeId String? // M-17 fix: "selectedMealTypeId" NOT "mealTypeId"
  mealPreference     String? // M-17 fix: "mealPreference" NOT "preference"

  createdAt DateTime @default(now())
  // Pass 14 (FR-EVTX-031): last-writer-wins resolves by this server timestamp.
  updatedAt DateTime @default(now()) @updatedAt

  party    EventGuestParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  mealType EventMealType?  @relation(fields: [mealTypeId], references: [id], onDelete: SetNull)

  @@index([partyId])
  @@map("event_persons")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG — Tracks all critical state changes across the platform
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String?
  actorId        String?     // User who performed the action
  targetId       String?     // Affected entity ID — can be User/Group/Meal/Event/etc.
  targetType     String      // "User" | "Group" | "Meal" | "Attendance" | "Event"
  action         AuditAction
  metadata       Json?       // Additional context (before/after snapshot)
  requestId      String?
  ipAddress      String?
  // Pass 14 (FR-DLC-006): HMAC-SHA256 over the row's canonical content,
  // keyed by AUDIT_HMAC_SECRET. Null = written while unsigned (key absent).
  integrityHmac  String?
  createdAt      DateTime    @default(now())

  // NOTE: targetId is intentionally NOT a FK — it can reference any entity type
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
  // Million-user scale: serves the two hot access paths in one index —
  // integrity verification (org + ORDER BY createdAt DESC LIMIT n) and the
  // retention purge (org + createdAt < cutoff) — without a sort step.
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}


// ─────────────────────────────────────────────────────────────────────────────
// NOTICE BOARD — Phase B: in-app announcements + bell center (no FCM)
// Additive + self-contained. organizationId / groupId / createdBy / userId are
// plain scalar columns (indexed) for tenant isolation WITHOUT altering the
// frozen Organization / User / Group models. The only relation is the
// self-contained Notice -> NoticeRead cascade.
// ─────────────────────────────────────────────────────────────────────────────

model Notice {
  id             String    @id @default(cuid())
  organizationId String    // tenant isolation (derived from JWT, never client)
  groupId        String?   // null = organization-wide notice
  createdBy      String    // admin userId who posted it
  title          String
  body           String
  priority       String    @default("normal") // low | normal | high | urgent
  // Audience gate (#4): "all" = everyone in scope (legacy behaviour, default),
  // "admins" = only org admins see it (request alerts), "members" = only members.
  audience       String    @default("all")     // all | admins | members
  // Notification Center deep-link (command_3): when set, tapping the notice
  // opens the related approval workflow directly. Value maps to a Flutter
  // screen (e.g. vacationRequests | correctionRequests). null = plain notice.
  linkType       String?
  // Notification Center (command_3): per-member targeted notice (approval /
  // rejection decisions). When set, ONLY this user sees it. null = everyone in
  // scope (audience-gated), the legacy behaviour.
  targetUserId   String?
  pinned         Boolean   @default(false)
  // SRS Module 03 NTC-003/012/013: optional rich content — at most ONE image
  // (≤100 KB, MinIO URL), ONE document (≤50 KB; pdf/doc/docx/txt, MinIO URL)
  // and external hyperlinks. Base64 storage is not permitted.
  imageUrl       String?
  documentUrl    String?
  documentName   String?
  externalLinks  String[]  @default([])
  publishedAt    DateTime  @default(now())
  expiresAt      DateTime?
  isActive       Boolean   @default(true)     // soft delete / archive
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  reads NoticeRead[]

  @@index([organizationId])
  @@index([groupId])
  @@index([organizationId, isActive])
  @@index([expiresAt])
  @@index([targetUserId])
  // Production scale: bell feed + unread-count filter on (org, isActive) and
  // ORDER BY publishedAt DESC — this serves the sort straight from the index
  // (no sort node) at any table size.
  @@index([organizationId, isActive, publishedAt(sort: Desc)])
  // Live-Test-11 collapsible-alert lookup: org + actor + publishedAt window.
  @@index([organizationId, createdBy, publishedAt])
  @@map("notices")
}

model NoticeRead {
  id       String   @id @default(cuid())
  noticeId String
  userId   String
  readAt   DateTime @default(now())
  // NTF-006 (Module 02): per-member bell dismissal. When set, the notice is
  // hidden from THIS user's bell (list + unread) without deleting the shared
  // notice for others. Null = visible. Additive + nullable.
  dismissedAt DateTime?

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([userId])
  @@map("notice_reads")
}


/// Issue 3 — vacation approval workflow. Self-contained, scalar-only (no Prisma
/// relations) so it is purely additive and never alters User/Group/Org models.
/// status: pending | approved | rejected | cancelled.
model VacationRequest {
  id             String    @id @default(cuid())
  organizationId String    // tenant isolation (from JWT, never client)
  groupId        String?   // optional group scope; null = org-level request
  userId         String    // requesting member
  userName       String?   // denormalised display name (additive, optional)
  startDate      DateTime  // inclusive
  endDate        DateTime  // inclusive
  // SRS FR-VACX-003 (Pass 11): optional meal-granular boundaries. On the
  // start date only meals whose window opens AT/AFTER startSlotKey's open
  // time are covered; on the end date only meals opening AT/BEFORE
  // endSlotKey's open time. Null = whole boundary day covered.
  startSlotKey   String?
  endSlotKey     String?
  reason         String?
  status         String    @default("pending")
  reviewedBy     String?   // admin userId who approved/rejected
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([userId])
  @@index([groupId])
  @@index([organizationId, status])
  @@map("vacation_requests")
}

/// Module 22 (Pass 8) — Member-Hosted Guest (FR-HG-010): one row per hosted
/// guest, attached to the host's attendance by (hostUserId, mealId,
/// attendanceDate). Accountless (FR-HG-002), tenant-scoped, price snapshotted
/// at booking (FR-HG-013). Self-contained scalars — purely additive.
/// status: booked | cancelled | no_show
/// pendingApproval: true while awaiting admin approval (guestRequiresApproval)
///                  or HOST confirmation (admin-added, FR-HG-062) — excluded
///                  from kitchen counts and billing until cleared.
model MealGuest {
  id             String   @id @default(cuid())
  organizationId String
  groupId        String
  mealId         String
  attendanceDate DateTime // UTC midnight business date
  hostUserId     String   // the member financially responsible (FR-HG-050)

  isAdult        Boolean @default(true)
  displayName    String?
  mealPreference String?
  // Live-Test-6 ISSUE-2: per-guest multi-preference-group selections —
  // immutable JSON snapshot at booking (same shape as AttendanceRecord
  // .preferences); price deltas are already folded into priceSnapshot.
  preferences    Json?
  status         String  @default("booked")
  pendingApproval Boolean @default(false)
  priceSnapshot  Int?    // effective guest price at booking — immutable

  createdBy   String    // host userId, or admin userId for on-behalf adds
  approvedBy  String?
  approvedAt  DateTime?
  cancelledBy String?
  cancelledAt DateTime?
  // Live-Test-11 ISSUE-002: TRUE only when FR-HG-035 auto-cancelled this guest
  // because the host flipped away from Present. The host returning to Present
  // inside the window restores exactly these; manual cancels never come back.
  autoCancelledWithHost Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, attendanceDate])
  @@index([hostUserId, attendanceDate])
  @@index([mealId, attendanceDate])
  @@index([organizationId])
  @@map("meal_guests")
}

/// SRS FR-DISP-010 (Pass 7) — Billing period finalization & controlled reopen.
/// Self-contained, scalar-only (no Prisma relations) — purely additive.
/// A 'finalized' period locks all attendance/billing writes for dates inside
/// [periodStart, periodEnd] (423 PERIOD_FINALIZED); 'reopened' lifts the lock
/// (audited, reason mandatory) until an admin re-finalizes.
// SRS Module 03 RPT-009/010/011 + RET-001..015: pre-purge archive record.
// The generated Excel + PDF in MinIO become the administrator's PERMANENT
// copy of everything removed from the live database (RET-010).
model GroupArchive {
  id             String   @id @default(cuid())
  organizationId String
  groupId        String
  groupName      String   // snapshot — survives later group deletion
  periodStart    DateTime // earliest archived business date (UTC midnight)
  periodEnd      DateTime // latest archived business date (inclusive)
  excelUrl       String
  pdfUrl         String?
  recordCounts   Json?    // per-dataset row counts for the audit trail
  generatedAt    DateTime @default(now())
  purgedAt       DateTime? // when the live rows were removed

  @@index([organizationId])
  @@index([groupId, generatedAt])
  @@map("group_archives")
}

model BillingPeriod {
  id             String   @id @default(cuid())
  organizationId String   // tenant isolation (from JWT, never client)
  groupId        String
  periodStart    DateTime // UTC midnight, inclusive
  periodEnd      DateTime // UTC midnight, inclusive
  status         String   @default("finalized") // finalized | reopened

  finalizedBy String
  finalizedAt DateTime @default(now())
  reopenedBy  String?
  reopenedAt  DateTime?
  reopenReason String?
  // Immutable reprint snapshot captured at finalize time (member totals).
  totalsSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([groupId, status])
  @@index([groupId, periodStart, periodEnd])
  @@map("billing_periods")
}

/// SRS FR-BILLX-030/031/033 (Pass 12, LOOP-010, GAP-103) — append-only billing
/// ledger. Every manual correction to a member's bill is a NEW immutable row
/// (credit | debit | refund), never an in-place edit of a price snapshot
/// (LOOP-004). Displayed balance = Σ(charges from snapshots) + Σ(signed
/// ledger amounts). Debits (liability increases) obey consent asymmetry
/// (FR-FAIR-001): they must reference an APPROVED correction request.
/// Self-contained scalars — purely additive; no update/delete path exists.
model BillingLedgerEntry {
  id             String   @id @default(cuid())
  organizationId String   // tenant isolation (from JWT, never client)
  groupId        String
  userId         String   // the member whose bill this entry adjusts
  entryDate      DateTime // UTC midnight business date the entry posts to
  type           String   // credit | debit | refund
  amount         Int      // positive minor units; sign derived from type
  reason         String   // mandatory human explanation
  refRecordId    String?  // AttendanceRecord being corrected (optional)
  refGuestId     String?  // MealGuest being corrected (optional)
  refRequestId   String?  // APPROVED AttendanceCorrectionRequest (consent proof)
  createdBy      String   // admin userId
  createdAt      DateTime @default(now())

  // command_6 (survey 2026-07-13) — member-consent debit workflow:
  // posted (default; counts in billing) | pending (debit awaiting the billed
  // member's approval — NOT counted) | rejected (member declined — never
  // counted). Additive; existing rows backfill to 'posted'.
  status         String    @default("posted")
  decidedAt      DateTime?
  decidedBy      String?   // the billed member who approved/rejected (self)

  @@index([organizationId])
  @@index([groupId, entryDate])
  @@index([groupId, userId, entryDate])
  @@index([userId, status])
  @@map("billing_ledger_entries")
}

/// Module 33 (MIG-010) — Attendance Correction Request: the member-initiated
/// consent path for attendance/billing changes (FR-ACR-*). Self-contained,
/// scalar-only (no Prisma relations) — purely additive, mirrors VacationRequest.
/// requestType: claim_present | correct_to_absent | correct_to_skip |
///              fix_preference | dispute_charge  (DTO-whitelisted)
/// status:      pending | approved | rejected | expired | cancelled
/// sourceChannel: member (member-raised) | admin_prompt (FR-OVR-020 member
///                confirmation created when an admin proposes an increase)
model AttendanceCorrectionRequest {
  id             String   @id @default(cuid())
  organizationId String   // tenant isolation (from JWT, never client)
  groupId        String
  userId         String   // the member whose record/bill is affected
  mealId         String
  attendanceDate DateTime // UTC midnight of the meal's business date

  requestType         String
  requestedStatus     String? // target AttendanceStatus for claim/correct types
  requestedPreference String? // for fix_preference
  // SRS Module 03 ATT-004/COR-006: the member's full preference-group
  // selection set submitted with the correction (same shape as marking).
  // Applied verbatim on approval — the admin never edits it.
  requestedSelections Json?
  reason              String?
  evidenceUrl         String? // optional photo proof (MinIO URL)

  status         String    @default("pending")
  reviewedBy     String?   // admin userId (or member userId for confirm/decline)
  reviewedAt     DateTime?
  reviewNote     String?
  sourceChannel  String    @default("member")
  resultRecordId String?   // AttendanceRecord id created/updated on approval

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // auto-expiry deadline (creation + ACR_EXPIRY_HOURS)

  @@index([groupId, status])
  @@index([userId, attendanceDate])
  @@index([organizationId])
  @@index([status, expiresAt]) // lazy expiry sweep
  @@map("attendance_correction_requests")
}
