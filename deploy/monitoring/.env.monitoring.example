# Copy to `.env` in this directory and fill real values. NEVER commit the real .env.
#   cp .env.monitoring.example .env && chmod 600 .env
#
# POSTGRES_* / REDIS_PASSWORD must MATCH the app's main .env (the exporters read
# the same DB/Redis the app uses, on localhost). GRAFANA_PASSWORD is new — pick a
# strong one (Grafana admin login).

# --- read by postgres-exporter (connects to host 127.0.0.1:5432) ---
POSTGRES_USER=emeal
POSTGRES_PASSWORD=SAME_AS_APP_ENV
POSTGRES_DB=emeal_db

# --- read by redis-exporter (connects to host 127.0.0.1:6379) ---
REDIS_PASSWORD=SAME_AS_APP_ENV

# --- Grafana admin (new credentials, not shared with anything else) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_STRONG
