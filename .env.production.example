# ── Production environment — emilestone.com / Contabo VPS 10 ──────────────────
# Copy to `.env` on the server and fill REAL secrets. NEVER commit the real .env.
# Generate strong secrets:  openssl rand -hex 32

NODE_ENV=production
PORT=3000

# PostgreSQL (docker-compose.prod.yml, localhost-bound)
POSTGRES_USER=emeal
POSTGRES_PASSWORD=CHANGE_ME_64_CHAR_RANDOM
POSTGRES_DB=emeal_db
POSTGRES_PORT=5432
# connection_limit pins the Prisma pool PER PM2 worker. With 4 workers, 4×10=40
# connections — safely under Postgres default max_connections=100 (leaves room for
# exporters + backup verify). If you add cores/workers, recompute: workers×limit < 100
# (or move to PgBouncer). pool_timeout caps how long a query waits for a free conn.
DATABASE_URL=postgresql://emeal:CHANGE_ME_64_CHAR_RANDOM@localhost:5432/emeal_db?schema=public&connection_limit=10&pool_timeout=20

# Redis (localhost-bound)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_64_CHAR_RANDOM

# JWT — access and refresh MUST be different 64+ char secrets
JWT_ACCESS_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_HEX
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_64_CHAR_HEX
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
BCRYPT_ROUNDS=12

# Bull Board (queue dashboard) — protect with strong creds.
# BULL_BOARD_SECRET is REQUIRED in production (env.validation.ts) — the app will
# refuse to boot without it. Generate:  openssl rand -hex 24
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=CHANGE_ME_STRONG
BULL_BOARD_SECRET=CHANGE_ME_48_CHAR_HEX

# MinIO image storage (self-hosted, S3-compatible) — meal images
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=emeal_minio_user
MINIO_SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM
MINIO_BUCKET=emeal-images
STORAGE_CDN_URL=https://cdn.emilestone.com

# Firebase FCM (Phase 2 push — leave blank until configured; push stays log-only/disabled)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Transactional email (Phase 1: OTP / password reset / verification) ───────
# AUTH identity (SMTP_USER) is separate from the FROM identity (MAIL_FROM) so an
# alias → dedicated-mailbox migration is ENV-ONLY (change SMTP_USER + SMTP_PASS).
# Leave SMTP_HOST/USER/PASS blank to keep email disabled (OTP still generates+verifies).
# See docs/NOTIFICATION_OTP_PLAN.md. DNS: add SPF + DKIM + DMARC before go-live.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@emilestone.com
SMTP_PASS=CHANGE_ME_MAILBOX_PASSWORD
# Public-facing brand (Play-Store app name) shown in emails. Internal code/git stays "eMeal".
MAIL_BRAND=MealAttend
MAIL_FROM="MealAttend <no-reply@emilestone.com>"
MAIL_REPLY_TO=admin@emilestone.com

# ── SMS OTP (Phase 3 — optional) ─────────────────────────────────────────────
# No free production SMS in India. Leave blank to keep SMS OTP disabled (phone
# OTP still generates+verifies, just isn't delivered). Recommended: MSG91 (paid,
# DLT-compliant) — or use Firebase Phone Auth (free tier, Flutter-side) instead.
SMS_PROVIDER=msg91
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_COUNTRY_CODE=91

# API rate limiting (per-IP). Default is 100/min — too low for shared networks
# (hostel WiFi / carrier NAT put many users behind ONE IP). 1000/min/IP fits a
# busy hostel while still stopping a runaway client. Monitor 429s in Loki + tune.
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000
