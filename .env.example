# Copy this to .env and fill in real values

NODE_ENV=development
PORT=3000
APP_NAME=eMeal-Server

POSTGRES_USER=emeal
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=emeal_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://emeal:CHANGE_ME@localhost:5432/emeal_db?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

JWT_ACCESS_SECRET=CHANGE_ME_64_CHARS_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_64_CHARS_MINIMUM
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

BCRYPT_ROUNDS=12

# Auth / OTP (Module 01 — Authentication & Onboarding)
OTP_TTL_SECONDS=600          # OTP validity window (AUTH-038, admin-configurable)
OTP_LENGTH=6                 # OTP digit count (Email OTP = 6, SRS Part 6)
OTP_MAX_ATTEMPTS=5           # Verify attempts before an OTP locks out (SEC-004)
RESET_PASSWORD_INVALIDATES_SESSIONS=true  # Kill existing sessions on password reset (Part 7 §2)
MOBILE_OTP_ENABLED=false     # SEC-008/AUTH-016 — keep false until Mobile OTP ships ("Coming Soon")

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=emeal-media
R2_PUBLIC_URL=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Audit trail (million-user scale) — all optional, defaults shown
AUDIT_FLUSH_INTERVAL_MS=1000     # micro-batch flush cadence; 0 = one INSERT per row (legacy)
AUDIT_BUFFER_MAX=200             # buffered rows that force an early flush
AUDIT_RETENTION_DAYS=180         # audit rows older than this are purged; 0 disables
AUDIT_CLEANUP_SWEEP_MINUTES=720  # retention sweep cadence; 0 disables

# Boot warmup — primes Prisma engine/pool + hot query paths per worker after
# every PM2 reload so the first real requests are not cold. 0 disables.
WARMUP_ON_BOOT=1
